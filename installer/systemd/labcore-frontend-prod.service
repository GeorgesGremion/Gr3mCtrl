[Unit]
Description=LabCore Frontend (built, static serve)
After=network.target labcore-backend.service
Requires=labcore-backend.service

[Service]
Type=simple
WorkingDirectory=/root/labcore/frontend
# Build and start Vite preview (serves /dist) on port 4173
ExecStart=/usr/bin/env bash -lc 'npm install && npm run build && npm run preview'
Restart=on-failure
RestartSec=3
User=root

[Install]
WantedBy=labcore.target
