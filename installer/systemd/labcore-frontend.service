[Unit]
Description=LabCore Frontend (Vite dev server)
After=network.target labcore-backend.service
Requires=labcore-backend.service

[Service]
Type=simple
WorkingDirectory=/root/labcore/frontend
ExecStart=/usr/bin/env bash -lc '/usr/bin/npm run dev -- --host'
Restart=on-failure
RestartSec=3
User=root

[Install]
WantedBy=labcore.target
