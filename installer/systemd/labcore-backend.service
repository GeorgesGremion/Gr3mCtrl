[Unit]
Description=LabCore Backend API (Go)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/labcore/backend
# Build latest binary to /usr/local/bin/labcore and start it
ExecStart=/usr/bin/env bash -lc 'go build -o /usr/local/bin/labcore && /usr/local/bin/labcore'
Restart=on-failure
RestartSec=3
User=root
Environment=GODEBUG=madvdontneed=1

[Install]
WantedBy=labcore.target
